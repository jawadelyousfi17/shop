# --- Database (Neon) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Resend ---
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Rise <orders@yourdomain.com>"
SUPPORT_EMAIL="support@yourdomain.com"

# --- Supabase (Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
SUPABASE_STORAGE_BUCKET="digital-products"

# --- Admin ---
ADMIN_EMAIL="admin@yourdomain.com"

# --- Download policy ---
DOWNLOAD_EXPIRY_DAYS="7"
DOWNLOAD_MAX_COUNT="5"

# --- Elyosoft outbound webhook (post-payment) ---
ELYOSOFT_WEBHOOK_URL="https://www.elyosoft.online/upadte-user"
ELYOSOFT_WEBHOOK_SECRET="REPLACE_WITH_LONG_RANDOM_SHARED_SECRET"
ELYOSOFT_SUCCESS_URL="https://www.elyosoft.online/"
